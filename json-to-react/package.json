{
  "name": "json-to-react",
  "version": "1.0.0",
  "description": "A tool to convert JSON schema to React components",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "demo": "ts-node src/demo.ts",
    "demo:interactive": "ts-node src/demo-interactive.ts",
    "gen": "ts-node src/tests/example.ts",
    "test": "vitest"
  },
  "keywords": [
    "json-schema",
    "react",
    "form-generator",
    "component-generator"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0",
    "vitest": "^4.0.13"
  }
}